# ==========================================
# Neon Serverless Postgres Configuration
# ==========================================
# Ambil Connection String dari dashboard Neon Console (https://console.neon.tech)
# Gunakan mode 'Pooled' untuk DATABASE_URL dan 'Direct' untuk DIRECT_URL
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# NextAuth / JWT Authentication Secret
# ==========================================
# String acak minimal 32 karakter untuk enkripsi token JWT sesi
AUTH_SECRET="50853589f82afc258e058183b4294e8c22bebc66c220503198b3232a3d8a1c8b"
